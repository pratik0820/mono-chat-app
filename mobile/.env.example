# Copy this file to .env.local and set your backend URL.
# - Android emulator: keep the default (10.0.2.2 reaches your machine's localhost)
# - Physical device (Pixel, etc.): your computer's LAN IP, e.g. http://192.168.1.20:8080
#   (find it with `ipconfig` on Windows; your phone must be on the same Wi-Fi)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
